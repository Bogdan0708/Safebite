{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:check": "SAFEBITE_UNVALIDATED_BUILD=1 npm run build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "preview:boot-guard": "vite preview --outDir dist-boot-guard --host 127.0.0.1 --port 4173 --strictPort",
    "preview:pwa": "vite preview --outDir dist-preview --host 127.0.0.1 --port 4174 --strictPort",
    "build:preview": "vite build --mode preview --outDir dist-preview",
    "build:preview-v2": "vite build --mode preview-v2 --outDir dist-preview-v2",
    "build:boot-guard": "SAFEBITE_UNVALIDATED_BUILD=1 vite build --mode boot-guard --outDir dist-boot-guard",
    "build:e2e": "npm run build:preview && npm run build:preview-v2 && npm run build:boot-guard",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:boot-guard": "playwright test -c playwright.boot-guard.config.ts",
    "e2e:preview": "playwright test -c playwright.preview.config.ts",
    "serve:upgrade": "node e2e-upgrade/server.mjs",
    "e2e:upgrade": "playwright test -c playwright.upgrade.config.ts",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
